# Default mode is deterministic, so the project is runnable without an API key.
AGENT_MODE=langgraph
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DATABASE_PATH=data/ops_pilot.db
DEMO_AUTH_FILE=data/demo-auth.json
# Generate local random credentials: python scripts/create_demo_accounts.py
# No default password/token. Management APIs require a generated bearer token.

# Default needs no embedding dependencies/cache/index. Explicit rollback: candidate.
# vector_rag is only supported with deterministic/langgraph mode, not live.
KNOWLEDGE_RETRIEVER=candidate
# KNOWLEDGE_RETRIEVER=vector_rag

# To use the optional DeepSeek-compatible LangGraph adapter after the user configures it:
# AGENT_MODE=live

# Optional local retrieval experiment and controlled Agent retrieval. Export in the shell;
# app/scripts do not automatically load .env files. Build indexes explicitly before enabling.
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_MODEL_CACHE=.rag-models
RAG_INDEX_PATH=.rag-index
